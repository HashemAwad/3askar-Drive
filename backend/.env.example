# Copy this file to backend/.env and fill it in. Never commit the real .env.

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/3askar-drive   # any MongoDB works, local or Atlas
SESSION_SECRET=change-me                              # signs the session cookie

# Optional (defaults shown)
PORT=5000
CLIENT_URL=http://localhost:5173                      # where the frontend is served

# Optional: "Continue with Google" only works when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Optional: forgot-password emails (Gmail address + app password)
EMAIL_USER=
EMAIL_PASS=
